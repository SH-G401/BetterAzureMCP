{
  "name": "betterazuremcp",
  "version": "0.1.0",
  "description": "A stable, private, read-only Azure MCP server for debugging Azure applications from GitHub Copilot, VS Code and other MCP clients.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "copilot",
    "debugging",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SH-G401/BetterAzureMCP.git"
  },
  "bugs": {
    "url": "https://github.com/SH-G401/BetterAzureMCP/issues"
  },
  "type": "module",
  "bin": {
    "betterazuremcp": "dist/betterazuremcp.mjs"
  },
  "files": [
    "dist/betterazuremcp.mjs",
    "dist/betterazuremcp.mjs.LEGAL.txt",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@azure/core-auth": "1.11.0",
    "@azure/core-rest-pipeline": "1.25.0",
    "@azure/identity": "4.13.3",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
